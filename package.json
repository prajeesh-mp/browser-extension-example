{
  "name": "my-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "format": "prettier --write .",
    "build:firefox": "tsc --noEmit && TARGET=firefox vite build",
    "zip": "npm run build && cd dist && zip -r ../extension-chrome.zip .",
    "zip:firefox": "npm run build:firefox && cd dist-firefox && zip -r ../extension-firefox.zip ."
  },
  "dependencies": {
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "@types/chrome": "^0.0.280",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.13.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
